<diagram id="p4" name="4 · kis unlock: which key it uses"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="kis unlock: how it picks the private key (the one key rule)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="40" as="geometry"/></mxCell>
<mxCell id="lane" value="keys.Resolve: the same rule in init, unlock, pubkey, sync and add (first match wins)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="190" width="980" height="490" as="geometry"/></mxCell>
<mxCell id="s" value="kis unlock [--identity PATH]" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="50" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="wi" value="wireGit: filters + pre-commit&lt;br&gt;(before any key is tried)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="d1" value="--identity PATH?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="a1" value="Uses &lt;b&gt;only&lt;/b&gt; that file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="235" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="x1" value="Error: no such file,&lt;br&gt;or not a private key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="235" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="d2" value="KIS_PRIVATE_KEY&lt;br&gt;set?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="d2b" value="age, or SSH&lt;br&gt;without passphrase?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="330" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="x2" value="Error: invalid key&lt;br&gt;(never falls through)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="345" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="a2" value="Uses &lt;b&gt;only&lt;/b&gt; that key&lt;br&gt;(key files are ignored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="450" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="c" value="Default locations, in order:&lt;br&gt;1. $KIS_IDENTITY (set but missing → error)&lt;br&gt;2. ~/.config/kis/identity&lt;br&gt;3. ~/.ssh/id_ed25519  4. ~/.ssh/id_rsa&lt;br&gt;(SSH passphrase: asked only if needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="d3" value="Found any?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="580" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="x3" value="Error: no key found → kis keygen&lt;br&gt;git is already wired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="595" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="u" value="&lt;b&gt;UnwrapKeys&lt;/b&gt;: for each group, try every&lt;br&gt;member's .age file with your keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="d4" value="Does one open?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="800" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="x4" value="Prints your public keys, exit 1&lt;br&gt;git is already wired: git add refuses&lt;br&gt;plaintext in secret files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="805" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="sv" value="ForgetKeys + save .git/kis/key&lt;br&gt;and .git/kis/groups/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="930" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="rf" value="Refresh: re-checkout → plaintext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1020" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="rn" value="Re-encrypt anything staged in plaintext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1100" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="end" value="✓ unlocked as NAME (key SOURCE)&lt;br&gt;e.g. (key from KIS_PRIVATE_KEY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1180" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="nt" value="The private key &lt;b&gt;only&lt;/b&gt; opens the master key.&lt;br&gt;The master key encrypts and decrypts&lt;br&gt;the files, so the private key is only&lt;br&gt;needed at unlock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="1020" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="nt2" value="&lt;b&gt;Same rule everywhere&lt;/b&gt;: kis pubkey prints&lt;br&gt;each key with its source; group creation&lt;br&gt;(sync, add --group NEW) and kis init pick&lt;br&gt;you the same way. Tested in key_rule&lt;br&gt;(cmd/kis/testdata/script)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="1140" width="320" height="110" as="geometry"/></mxCell>
