<mxCell id="t" value="kis init (owner, once per repository)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="40" as="geometry"/></mxCell>
