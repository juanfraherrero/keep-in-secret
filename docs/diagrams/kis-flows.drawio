<mxCell id="r_env" value="&lt;b&gt;.env&lt;/b&gt; → ciphertext only&lt;br&gt;header \0KIS\0v1\0…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="300" height="60" as="geometry"/></mxCell>
