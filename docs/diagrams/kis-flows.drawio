<mxCell id="p_m" value="Generate the &lt;b&gt;master key&lt;/b&gt;&lt;br&gt;(32 random bytes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="560" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="p_w" value="Cache in .git/kis/key · wrap into&lt;br&gt;.kis/keys/YOU.age · recipients.toml · config.toml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="650" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="f_w" value="Committed: .kis/*&lt;br&gt;Local only: .git/kis/key" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="720" y="650" width="300" height="70" as="geometry"/></mxCell>
