<mxCell id="f_id" value="~/.config/kis/identity (0600)&lt;br&gt;or ~/.ssh/id_ed25519" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="720" y="380" width="300" height="60" as="geometry"/></mxCell>
