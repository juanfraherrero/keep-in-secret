<diagram id="p10" name="10 · kis init when things already exist"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="kis init when keys or kis files already exist" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="40" as="geometry"/></mxCell>
<mxCell id="s" value="kis init" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="d1" value=".kis/config.toml&lt;br&gt;exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="140" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="r1" value='&lt;b&gt;Refuse&lt;/b&gt;: "already set up" → kis unlock / kis add.&lt;br&gt;Wrapped keys and other partners untouched' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="d2" value=".kis/ exists&lt;br&gt;anyway?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="260" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;Broken repo: refuse&lt;/b&gt;. config.toml is missing;&lt;br&gt;restore it from git history. Every kis command&lt;br&gt;refuses the same way (status --json: error).&lt;br&gt;A new init would drop the partners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="255" width="360" height="100" as="geometry"/></mxCell>
<mxCell id="d3" value="Personal key found?&lt;br&gt;(~/.config/kis/identity,&lt;br&gt;or --identity PATH)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="380" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="d4" value="Valid key?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="500" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="r4" value="&lt;b&gt;Refuse with a clear message&lt;/b&gt;:&lt;br&gt;&quot;found a key file at PATH, but it can't be opened&quot;&lt;br&gt;or &quot;PATH is a public key&quot;. Nothing is written;&lt;br&gt;the key file is left exactly as it was" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="500" width="360" height="90" as="geometry"/></mxCell>
<mxCell id="r5" value="&lt;b&gt;Reuse it&lt;/b&gt;: same public key,&lt;br&gt;file never rewritten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="620" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="r6" value="Create a new age key&lt;br&gt;(O_EXCL, 0600)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="395" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="m" value="&lt;b&gt;New master key for this repo&lt;/b&gt;,&lt;br&gt;wrapped to your public key →&lt;br&gt;.kis/keys/YOU.age + recipients.toml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="730" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;b&gt;Facts behind these branches:&lt;/b&gt;&lt;br&gt;• One personal key per machine; one master key&lt;br&gt;&amp;nbsp;&amp;nbsp;per repository.&lt;br&gt;• Public keys live in .kis/recipients.toml.&lt;br&gt;• Wrapped master keys live in .kis/keys/NAME.age.&lt;br&gt;• The private key never enters the repo.&lt;br&gt;&lt;br&gt;Tested in cmd/kis/testdata/script/&lt;br&gt;init_existing_state.txtar (scenarios 1–5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="620" width="360" height="190" as="geometry"/></mxCell>
<mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" value="yes · scenario 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d1" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e16" value="yes · scenario 4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d2" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d3" target="r6"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e20" value="no · scenarios 2, 5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d4" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e21" value="yes · scenario 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d4" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="r5" target="m"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="r6" target="m"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="p11" name="11 · kis init: picking the identity"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="kis init: how your key is picked (the one key rule)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="40" as="geometry"/></mxCell>
<mxCell id="lane" value="keys.Resolve: the same rule as every command (page 4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="10" y="110" width="1040" height="385" as="geometry"/></mxCell>
<mxCell id="s" value="kis init [--identity PATH]" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="50" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="d1" value="--identity PATH?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="140" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="a1" value="Use &lt;b&gt;only&lt;/b&gt; that file (your &lt;b&gt;private&lt;/b&gt; key);&lt;br&gt;the public key is derived from it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="145" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="a1n" value="&lt;b&gt;Errors&lt;/b&gt; (all loud, nothing lost):&lt;br&gt;• a .pub → &quot;PATH is a public key&quot;&lt;br&gt;• unreadable → &quot;found a key file at PATH, but it&lt;br&gt;&amp;nbsp;&amp;nbsp;can't be opened&quot;&lt;br&gt;• ECDSA / sk- → &quot;unsupported key type&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="225" width="380" height="115" as="geometry"/></mxCell>
<mxCell id="d1b" value="KIS_PRIVATE_KEY&lt;br&gt;set?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="260" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="env" value="Use &lt;b&gt;only&lt;/b&gt; that key as the first partner;&lt;br&gt;&lt;b&gt;no key file&lt;/b&gt; is written.&lt;br&gt;Not a key → loud error, nothing written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="265" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="c" value="Default locations, in order:&lt;br&gt;$KIS_IDENTITY · ~/.config/kis/identity ·&lt;br&gt;~/.ssh/id_ed25519 · ~/.ssh/id_rsa&lt;br&gt;(a set but missing KIS_IDENTITY → error)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="d2" value="Terminal, and&lt;br&gt;no -y?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="510" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="m" value='&lt;b&gt;Menu&lt;/b&gt;: each candidate +&lt;br&gt;"Create a new kis key (recommended)".&lt;br&gt;Default: first age key, else create' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="510" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="dflt" value="No prompt: take the default&lt;br&gt;(first age key, else create one)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="630" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="d3" value="Create a&lt;br&gt;new key?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="720" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="use" value="Use the chosen key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="735" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="d4" value="~/.config/kis/identity&lt;br&gt;already exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="840" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="gen" value='Generate an age key (O_EXCL, 0600):&lt;br&gt;"created your key at …"' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="855" width="250" height="60" as="geometry"/></mxCell>
<mxCell id="d5" value="Valid key?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="960" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="bad" value="&lt;b&gt;Refuse&lt;/b&gt;: &quot;found a key file … can't be opened&quot;&lt;br&gt;+ restore from a backup, or kis keygen --force" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="970" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="reuse" value="&lt;b&gt;Reuse it&lt;/b&gt; (the file is never rewritten)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1080" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="end" value="Public key → .kis/recipients.toml&lt;br&gt;default_key = its type (age / ssh)&lt;br&gt;→ the instructions printed for partners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1180" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="w" value='No terminal and you are the only partner:&lt;br&gt;&lt;b&gt;"The only key that can unlock this&lt;br&gt;repository is …"&lt;/b&gt;: add another&lt;br&gt;partner (kis add NAME KEY) before pushing' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1300" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="nt" value="&lt;b&gt;The path is not remembered&lt;/b&gt; (issue #9).&lt;br&gt;Pass --identity PATH again to unlock, pubkey,&lt;br&gt;and sync / add when they create a group,&lt;br&gt;or set KIS_IDENTITY=PATH.&lt;br&gt;&lt;br&gt;Tested in key_rule, init_private_key,&lt;br&gt;init_existing_state, init_interactive, init_ssh&lt;br&gt;and ssh_passphrase (cmd/kis/testdata/script)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="1080" width="380" height="160" as="geometry"/></mxCell>
<mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="s" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d1" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="a1" target="a1n"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e25" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d1" target="d1b"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e26" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d1b" target="env"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d1b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="env" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
