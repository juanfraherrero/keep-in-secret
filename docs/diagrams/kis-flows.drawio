<mxCell id="p_at" value="SyncAttributes:&lt;br&gt;.gitencrypt → block in .gitattributes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="840" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="p_ad" value="git add: .env goes through clean →&lt;br&gt;staged &lt;b&gt;encrypted&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="930" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="p_ag" value="Add the kis section to AGENTS.md&lt;br&gt;(+ CLAUDE.md, …) unless --no-agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="1020" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="d_ig" value="Is .env in&lt;br&gt;.gitignore?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="1110" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="x_ig" value="Offer to un-ignore it (!/.env)&lt;br&gt;and stage it encrypted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="1125" width="300" height="60" as="geometry"/></mxCell>
