<mxCell id="e18" value="sends the public key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="p2" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell>
