<mxCell id="c" value="Candidatos en orden:&lt;br&gt;1. $KIS_IDENTITY  2. ~/.config/kis/identity&lt;br&gt;3. ~/.ssh/id_ed25519  4. ~/.ssh/id_rsa&lt;br&gt;(passphrase SSH: prompt solo si hace falta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="300" height="90" as="geometry"/></mxCell>
