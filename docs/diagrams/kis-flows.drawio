<mxCell id="k4" value="4 · encrypted for the right &lt;b&gt;group&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="340" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="k5" value="5 · encrypted in &lt;b&gt;HEAD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="k6" value="6 · with --since REV: every commit in&lt;br&gt;REV..HEAD that adds or changes a secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="480" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="d" value="Any error?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="570" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="bad" value="safe_to_push = false&lt;br&gt;--check → exit 1 · each problem with its fix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="580" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="ok" value="safe_to_push = true · exit 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="w" value="&lt;b&gt;Warnings&lt;/b&gt; (don't block):&lt;br&gt;• filters / hook missing (fix: kis unlock)&lt;br&gt;• git &amp;lt; 2.28 (&quot;upgrade git&quot;, no command)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="nc" value="&lt;b&gt;Does NOT cover:&lt;/b&gt;&lt;br&gt;• secrets in other files&lt;br&gt;• history before REV&lt;br&gt;• ciphertext made with a retired key (issue #8)&lt;br&gt;• keyless clone: no warning that the next&lt;br&gt;&amp;nbsp;&amp;nbsp;commit would be plaintext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="270" width="320" height="150" as="geometry"/></mxCell>
<mxCell id="out" value="&lt;b&gt;Outputs:&lt;/b&gt;&lt;br&gt;• text: for people&lt;br&gt;• --json: for agents&lt;br&gt;&amp;nbsp;&amp;nbsp;(safe_to_push, files[].state,&lt;br&gt;&amp;nbsp;&amp;nbsp;problems[].severity / fix)&lt;br&gt;• --check: the exit code&lt;br&gt;• --since origin/main: the whole PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="130" width="240" height="200" as="geometry"/></mxCell>
