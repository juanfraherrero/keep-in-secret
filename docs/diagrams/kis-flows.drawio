<mxCell id="L3" value="Remote repository" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="320" height="1100" as="geometry"/></mxCell>
<mxCell id="p1" value="kis keygen" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="p2" value="Creates ~/.config/kis/identity (0600)&lt;br&gt;Prints &lt;b&gt;only the public key&lt;/b&gt; age1…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="o1" value="Receives age1… over any channel&lt;br&gt;(it is public: Slack, email, a PR…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="300" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="o2" value='kis add ana KEY&lt;br&gt;KEY = age1… | "ssh-ed25519 …" |&lt;br&gt;github:ana | ana.pub' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="390" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="o3" value="ResolveRecipients validates it;&lt;br&gt;rejects private, ECDSA and sk- keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="490" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="o4" value="age wraps the master key for ana&lt;br&gt;→ .kis/keys/ana.age · recipients.toml&lt;br&gt;git add .kis/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="590" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="o5" value="git commit &amp;&amp; git push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="700" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="o6" value="Requirement: the owner must be&lt;br&gt;&lt;b&gt;unlocked&lt;/b&gt; (needs the master key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="790" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="r1" value=".kis/keys/ana.age&lt;br&gt;on the remote" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="840" y="700" width="280" height="60" as="geometry"/></mxCell>
<mxCell id="p3" value="git clone / git pull" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="p4" value="kis unlock" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="p5" value="Opens ana.age with her private key&lt;br&gt;→ gets the master key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="320" height="70" as="geometry"/></mxCell>
<mxCell id="p6" value="Caches .git/kis/key · wires git ·&lt;br&gt;re-checkout → .env in plaintext ✓" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="320" height="80" as="geometry"/></mxCell>
