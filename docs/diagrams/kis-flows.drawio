<mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="a1" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="p12" name="12 · Groups: how they are built"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="Groups: secrets for some people only" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="40" as="geometry"/></mxCell>
<mxCell id="L1" value=".gitencrypt → git" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="360" height="530" as="geometry"/></mxCell>
<mxCell id="L2" value="Committed in .kis/" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="50" width="360" height="530" as="geometry"/></mxCell>
<mxCell id="L3" value="This clone only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;verticalAlign=top;fontStyle=1;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="50" width="360" height="530" as="geometry"/></mxCell>
<mxCell id="ge" value="&lt;b&gt;.gitencrypt&lt;/b&gt;&lt;br&gt;.env&lt;br&gt;.env.*&lt;br&gt;.env.production &lt;b&gt;@prod&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="ga" value="&lt;b&gt;.gitattributes&lt;/b&gt; (managed block)&lt;br&gt;.env … !kis-group&lt;br&gt;.env.production … &lt;b&gt;kis-group=prod&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="320" height="90" as="geometry"/></mxCell>
<mxCell id="cl" value="&lt;b&gt;clean filter&lt;/b&gt; (git add):&lt;br&gt;git check-attr kis-group →&lt;br&gt;picks that group's key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="sm" value="&lt;b&gt;smudge / diff / merge&lt;/b&gt;:&lt;br&gt;read the group from the&lt;br&gt;file's v2 header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="kd" value="&lt;b&gt;.kis/keys/&lt;/b&gt;juan.age, ana.age&lt;br&gt;the &lt;b&gt;default&lt;/b&gt; key, wrapped&lt;br&gt;once per member" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="kp" value="&lt;b&gt;.kis/keys/prod/&lt;/b&gt;juan.age, deploy.age&lt;br&gt;the &lt;b&gt;prod&lt;/b&gt; key, wrapped&lt;br&gt;once per member" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="440" y="240" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="mem" value="&lt;b&gt;Membership = which .age files exist.&lt;/b&gt;&lt;br&gt;No separate member list.&lt;br&gt;Each group has its own random&lt;br&gt;master key." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="380" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;.git/kis/key&lt;/b&gt;&lt;br&gt;default key" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="840" y="100" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;.git/kis/groups/prod&lt;/b&gt;&lt;br&gt;only if you are in prod" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="840" y="190" width="320" height="60" as="geometry"/></mxCell>
<mxCell id="v1" value="&lt;b&gt;v1 file&lt;/b&gt; (default group):&lt;br&gt;\0KIS\0v1\0 | nonce | ciphertext&lt;br&gt;(byte for byte as before groups)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="290" width="320" height="80" as="geometry"/></mxCell>
<mxCell id="v2" value='&lt;b&gt;v2 file&lt;/b&gt; (named group):&lt;br&gt;\0KIS\0v2\0 | length | "prod" | nonce |&lt;br&gt;ciphertext. The header is authenticated:&lt;br&gt;relabelling a file breaks decryption' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="400" width="320" height="100" as="geometry"/></mxCell>
<mxCell id="e15" value="kis sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="ge" target="ga"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="ga" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e17" value="kis unlock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="kd" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e18" value="kis unlock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="kp" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e19" value="key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="c2" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e20" value="git add" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="cl" target="v2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e21" value="checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="v2" target="sm"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="leg" value="&lt;b&gt;No @group anywhere = no groups:&lt;/b&gt; no prod/ folder, every file stays v1, and kis never mentions groups. A file belongs to exactly one group; to share it with more people, add them to that group." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1160" height="60" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="p13" name="13 · Groups: create, add, work, remove"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="Groups: what each command does" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="40" as="geometry"/></mxCell>
<mxCell id="hA" value="A · Create a group" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="a1" value='Add ".env.production @prod"&lt;br&gt;to .gitencrypt' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="90" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="a2" value="kis sync (or kis init, if the&lt;br&gt;line was already there)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="170" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="a3" value="ensureGroups: prod has no key yet →&lt;br&gt;new random master key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="a4" value="Wrap it for &lt;b&gt;you&lt;/b&gt; (whoAmI: which partner&lt;br&gt;is this machine?) →&lt;br&gt;.kis/keys/prod/YOU.age" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="340" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="a4x" value="whoAmI fails (key at a custom&lt;br&gt;path, without --identity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="345" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="a5" value="Cache .git/kis/groups/prod ·&lt;br&gt;re-encrypt .env.production as v2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="440" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="not found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="a4" target="a4x"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="hB" value="B · Add someone to a group" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="40" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="b1" value="kis add deploy KEY --group prod&lt;br&gt;(existing partner: kis add ana --group prod)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="b2" value="Do you hold the&lt;br&gt;prod key?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="180" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="b2n" value="Error: ask a member&lt;br&gt;of prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="195" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="b3" value="Wrap the prod key for their keys&lt;br&gt;→ .kis/keys/prod/deploy.age" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="310" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="b4" value="A new partner added only with&lt;br&gt;--group prod gets prod only,&lt;br&gt;not the default group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="410" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="b5" value="commit &amp;&amp; push → they run kis unlock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="510" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="b2" target="b2n"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e22" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="b3" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="hC" value="C · Working in a clone that isn't in prod" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="c1" value="kis unlock (ana: default group only)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="650" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c2" value='"not in group prod: .env.production&lt;br&gt;stays encrypted"' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="730" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="c3" value="Edits and commits as usual: the prod&lt;br&gt;file passes through as ciphertext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="820" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="c4" value="kis status: .env.production&lt;br&gt;[prod, no access here]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="910" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="hD" value="D · Remove someone from a group" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="600" width="400" height="40" as="geometry"/></mxCell>
<mxCell id="d1" value="kis remove ana --group prod" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="650" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="d2" value="Rotates &lt;b&gt;only&lt;/b&gt; the prod key;&lt;br&gt;the default key and files are untouched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="730" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="d3" value="ana stays a partner&lt;br&gt;(default group)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="820" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="d4" value="Without --group: removed from every&lt;br&gt;group she is in, each one rotated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="780" y="910" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="d1" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>
