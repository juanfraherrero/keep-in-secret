# CI runners and cloud agents (Codex, Claude Code on the web, Copilot…) start
# from a fresh clone with no key files; their only secret is the
# KIS_PRIVATE_KEY environment variable. Each one is its own partner.

exec kis keygen
cd app
exec git init -q
exec kis init -y --name owner
exec git add .
exec git commit -qm init

# The owner creates a bot partner in one step. Its private key is printed
# once and is never written to disk, not even in the repository.
# stdout is the key alone, on one line, so it can be piped straight into the
# platform's secret store; every message goes to stderr.
exec kis add ci --new-key
stdout '\AAGE-SECRET-KEY-1[0-9A-Z]+\n\z'
stderr '✓ added ci \(1 key\(s\), age\)'
stderr 'Private key of ci \(shown once, saved nowhere\):'
stderr 'The private key is on stdout: pipe it straight into your CI or agent platform''s secret store as KIS_PRIVATE_KEY; never into logs, files or chat\.'
stderr 'Now commit and push\. Lost the key\? kis add ci --new-key --force'
! stderr 'AGE-SECRET-KEY'
readvar FIRST_KEY stdout 'AGE-SECRET-KEY-1[0-9A-Z]+'
nowhere FIRST_KEY $WORK
exists .kis/keys/ci.age

# A key printed where it shouldn't be is replaced with --force, with the same
# output split. The first key stops working once this is committed and pushed.
exec kis add ci --new-key --force
stdout '\AAGE-SECRET-KEY-1[0-9A-Z]+\n\z'
stderr '✓ replaced the keys of ci \(1 key\(s\), age\)'
stderr 'The private key is on stdout'
! stderr 'AGE-SECRET-KEY'
readvar CI_KEY stdout 'AGE-SECRET-KEY-1[0-9A-Z]+'
nowhere CI_KEY $WORK
! exec kis add ci --new-key
stderr 'ci already has access; use --force'
! stdout .
! exec kis add ci2 age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq --new-key
stderr '--new-key creates the key, so don''t pass one'

# A second bot only for production secrets.
cp $WORK/gitencrypt .gitencrypt
cp $WORK/prod .env.production
exec kis sync
exec kis add deploy --new-key --group prod
stdout '\AAGE-SECRET-KEY-1[0-9A-Z]+\n\z'
stderr '✓ added deploy to prod'
readvar DEPLOY_KEY stdout 'AGE-SECRET-KEY-1[0-9A-Z]+'
nowhere DEPLOY_KEY $WORK
exec git add .
exec git commit -qm 'bots'
exec git push -q $REMOTE HEAD:main

# The CI runner: a fresh machine with no keys of its own.
as ci
! exists $KIS_KEY
cd $WORK
exec git clone -q $REMOTE ci
cd ci
encrypted .env

# Without the variable it can't unlock, and says what to do.
! exec kis unlock
stderr 'no key found on this machine'

# The replaced key no longer unlocks.
env KIS_PRIVATE_KEY=$FIRST_KEY
! exec kis unlock
stderr 'none of your keys has access'
encrypted .env

# With it, one command. The key comes from the environment only.
env KIS_PRIVATE_KEY=$CI_KEY
exec kis pubkey
stdout '# KIS_PRIVATE_KEY \(age\); key files are ignored while it is set'
exec kis unlock
stdout '✓ unlocked as ci \(key from KIS_PRIVATE_KEY\) \(groups: default\); decrypted 1 file'
stdout 'not in group prod: \.env\.production stays encrypted \(ask a member: kis add ci --group prod\)'
! exists $KIS_KEY
nowhere CI_KEY $WORK
! encrypted .env
cmp .env $WORK/app/.env
encrypted .env.production
exec kis status --check
stdout 'safe to push    yes'

# The variable is only needed for unlock: after that, committing, pulling and
# checking out use the repository key git already has.
env KIS_PRIVATE_KEY=
cp $WORK/ci-env .env
exec git commit -qam 'ci updates a secret'
stored HEAD .env
exec git push -q $REMOTE HEAD:main

# The cloud agent can create a group too (it is the member, from the variable).
env KIS_PRIVATE_KEY=$CI_KEY
cp $WORK/gitencrypt-staging .gitencrypt
exec kis sync
stdout 'created group staging with you \(ci\) as its member'
exec kis add owner --group staging
stdout '✓ added owner to staging'
exec git add .
exec git commit -qm 'staging group'
exec git push -q $REMOTE HEAD:main
env KIS_PRIVATE_KEY=

# The deploy bot only reads production secrets.
as deploy
cd $WORK
exec git clone -q $REMOTE deploy
cd deploy
env KIS_PRIVATE_KEY=$DEPLOY_KEY
exec kis unlock
stdout '✓ unlocked as deploy \(key from KIS_PRIVATE_KEY\) \(groups: prod\)'
! encrypted .env.production
cmp .env.production $WORK/prod
encrypted .env
env KIS_PRIVATE_KEY=

# The owner gets the bot's change as plaintext, like any partner's.
as owner
cd $WORK/app
exec git pull -q $REMOTE main
cmp .env $WORK/ci-env

# On a laptop, a set variable wins over the key files (and says so), and
# --identity wins over the variable. Unsetting it brings the laptop key back.
env KIS_PRIVATE_KEY=$CI_KEY
exec kis unlock
stdout 'unlocked as ci \(key from KIS_PRIVATE_KEY\)'
exec kis unlock --identity $KIS_KEY
stdout 'unlocked as owner \(key from --identity .*identity\) \(groups: default, prod, staging\)'
! stdout 'KIS_PRIVATE_KEY'
env KIS_PRIVATE_KEY=
exec kis unlock
stdout 'unlocked as owner \(key .*identity\) \(groups: default, prod, staging\)'

# Rotating keys doesn't break the bots: the same secret keeps working.
exec kis rotate
exec git add .
exec git commit -qm rotate
exec git push -q $REMOTE HEAD:main
as ci
cd $WORK
exec git clone -q $REMOTE ci-after-rotate
cd ci-after-rotate
env KIS_PRIVATE_KEY=$CI_KEY
exec kis unlock
stdout 'unlocked as ci'
cmp .env $WORK/ci-env

# Removing the bot revokes it: the same secret no longer unlocks.
as owner
cd $WORK/app
exec kis remove ci
exec git add .
exec git commit -qm 'remove ci'
exec git push -q $REMOTE HEAD:main
as ci
cd $WORK
exec git clone -q $REMOTE ci-removed
cd ci-removed
env KIS_PRIVATE_KEY=$CI_KEY
! exec kis unlock
stderr 'none of your keys has access'
stderr 'age1[0-9a-z]+  \(from KIS_PRIVATE_KEY\)'
encrypted .env

# Bad values fail clearly instead of falling back to other keys.
env KIS_PRIVATE_KEY=not-a-key
! exec kis unlock
stderr 'KIS_PRIVATE_KEY: not an age or SSH private key'
sshkey -passphrase hunter2 bot $WORK/botkey
readvar BOT_SSH $WORK/botkey
env KIS_PRIVATE_KEY=$BOT_SSH
! exec kis unlock
stderr 'KIS_PRIVATE_KEY: passphrase-protected SSH keys can''t be used here'

# An SSH key without a passphrase works too (multi-line variable).
as owner
cd $WORK/app
sshkey runner $WORK/runnerkey
exec kis add runner $WORK/runnerkey.pub
exec git add .
exec git commit -qm runner
exec git push -q $REMOTE HEAD:main
as runner
cd $WORK
exec git clone -q $REMOTE runner
cd runner
readvar RUNNER_SSH $WORK/runnerkey
env KIS_PRIVATE_KEY=$RUNNER_SSH
exec kis unlock
stdout 'unlocked as runner \(key from KIS_PRIVATE_KEY\)'
cmp .env $WORK/ci-env

-- app/.env --
API_KEY=dev-123
-- prod --
DB_PASSWORD=prod-secret
-- ci-env --
API_KEY=dev-456
-- gitencrypt --
.env
.env.*
.env.production @prod
-- gitencrypt-staging --
.env
.env.*
.env.production @prod
.env.staging @staging
