# Binary secrets (keystores, certificates) are encrypted like any other file:
# add the pattern to .gitencrypt, run kis sync, and a partner gets the file
# back byte for byte.

cd app
exec git init -q
exec kis init -y --name owner
exec git commit -qm init

binfile release.jks
cp $WORK/gitencrypt .gitencrypt
exec kis sync
stdout '✓ updated \.gitattributes from \.gitencrypt'
stdout '✓ staged encrypted: release\.jks'
attr release.jks filter kis
stored : release.jks
exec git commit -qm 'encrypt the keystore'
stored HEAD release.jks
exec kis status --check
exec git status --porcelain
! stdout .

# The partner clones, unlocks and gets the exact bytes.
exec git push -q $REMOTE HEAD:main
as ana
exec kis keygen
pubkey ANA
as owner
exec kis add ana $ANA
exec git commit -qm 'add ana'
exec git push -q $REMOTE HEAD:main
as ana
cd $WORK
exec git clone -q $REMOTE ana
cd ana
encrypted release.jks
exec kis unlock
! encrypted release.jks
cmp release.jks $WORK/app/release.jks
exec git status --porcelain
! stdout .

-- app/.env --
A=1
-- gitencrypt --
.env
*.jks
