# kis init --ssh uses ~/.ssh/id_ed25519 and makes SSH the default for partners.
[!ssh-keygen] skip 'needs ssh-keygen'

exec ssh-keygen -q -t ed25519 -N '' -C owner@laptop -f $HOME/.ssh/id_ed25519

cd app
exec git init -q
exec kis init --ssh -y --name owner
stdout 'encrypted for owner \(ssh key .*\.ssh/id_ed25519\)'
stdout 'This repo uses SSH keys'
stdout 'kis add NAME github:THEIR_USER'
! exists $KIS_KEY
grep 'default_key = "ssh"' .kis/config.toml
grep '^owner = \["ssh-ed25519 AAAA[^"]+ owner@laptop"\]$' .kis/recipients.toml

exec git add .
exec git commit -qm init
stored HEAD .env

# lock: key cache gone, working copy back to ciphertext, tree still clean
snapshot before-lock
exec kis lock
stdout 'locked; 1 file\(s\) back to ciphertext'
changed before-lock ~.env -.git/kis/key
encrypted .env
exec git status --porcelain
! stdout .
exec kis status
stdout 'state +LOCKED'

# unlock with the SSH key restores everything
exec kis unlock
stdout 'unlocked as owner; decrypted 1 file\(s\)'
cmp .env $WORK/env
exec git status --porcelain
! stdout .

# --ssh without an SSH key fails clearly
as nokey
cd $WORK
exec git init -q other
cd other
! exec kis init --ssh -y
stderr 'no SSH key found in ~/.ssh'
-- app/.env --
TOKEN=abc
-- env --
TOKEN=abc
