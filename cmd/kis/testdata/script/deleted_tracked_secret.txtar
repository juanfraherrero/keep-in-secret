# A tracked secret deleted from disk (a deletion not staged yet) must not
# break kis init or kis sync (#16): there is nothing to encrypt.

# --- kis sync ---
cd app
exec git init -q
exec kis init -y --name owner
exec git commit -qm init
rm .env.production
exec kis sync
stdout 'encrypted files: \.env'
stored : .env .env.production
exec kis status --check

# kis unlock still restores it from the index, as before.
exec kis lock --force
rm .env.production
exec kis unlock
stdout 'unlocked as owner'
exists .env.production
! encrypted .env.production

# --- kis init, after .env was committed in plaintext and deleted from disk ---
# init completes, and now prints the warning about the plaintext in HEAD.
cd $WORK/old
exec git init -q
exec git add .
exec git commit -qm 'plaintext env'
rm .env
exec kis init -y --name owner
stdout 'already committed in PLAINTEXT before: \.env'
exists .kis/config.toml

# The old plaintext index entry is still there, and kis status says so until
# the deletion is staged.
! exec kis status --check
stdout '\.env: staged in plaintext'
exec git rm -q --cached .env
exec kis status --check

-- app/.env --
A=1
-- app/.env.production --
P=1
-- old/.env --
DB=secret
-- old/README.md --
app
